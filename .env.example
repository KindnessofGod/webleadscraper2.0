# Where Stage A gets raw leads.
#   places_api  (default, recommended) -- Google's official Places API.
#                No proxy, no browser, no bot-detection fight. See README
#                "Google Places API setup".
#   maps_scrape -- Playwright against the Google Maps web UI. Google
#                blocks automated browsers coming from commercial proxy
#                ranges (silently -- requests hang rather than erroring),
#                so this needs a proxy pool Google hasn't flagged.
SOURCE_PROVIDER=places_api

# Google Cloud API key with "Places API (New)" enabled.
PLACES_API_KEY=your_places_api_key

# ---------------------------------------------------------------------
# Everything below is only used when SOURCE_PROVIDER=maps_scrape.
# ---------------------------------------------------------------------

# Which proxy provider is active. Use "webshare" first (free tier, zero
# cost) to verify the scraper actually works before switching to
# "dataimpulse" (paid) for the real pilot -- see README "Using Webshare".
PROXY_PROVIDER=webshare

# Webshare free tier: sign up at https://www.webshare.io (no card required).
# The Free plan is 10 static proxy IPs connected to DIRECTLY (no shared
# gateway domain) -- Dashboard -> Free -> Proxy List shows a table of
# "Proxy Address" / "Port" (all sharing one Username/Password). Paste as
# many of those host:port pairs as you want to use, comma-separated, plus
# the one shared username/password.
#
# Also: Dashboard -> Free -> Proxy Settings -> IP Authorizations -- you
# MUST add your server's own outbound IP there (run `curl -s
# https://ipv4.webshare.io/` on the server to get it) or every request
# gets a 407 "not in your list" rejection.
WEBSHARE_PROXIES=1.2.3.4:6754,5.6.7.8:7684
WEBSHARE_USERNAME=your_webshare_proxy_username
WEBSHARE_PASSWORD=your_webshare_proxy_password

# DataImpulse residential proxy credentials (paid, $1/GB, $5 minimum)
# https://dataimpulse.com dashboard -> proxy list
DATAIMPULSE_HOST=gw.dataimpulse.com
DATAIMPULSE_USERNAME=your_username
DATAIMPULSE_PASSWORD=your_password

# Tier 2 qualification search API. Provider must be one of: serper, searlo
TIER2_SEARCH_PROVIDER=serper
TIER2_SEARCH_API_KEY=your_api_key

# SQLite path (checkpoints, leads, logs, cost ledger all live here)
DB_PATH=./data/leads.db
